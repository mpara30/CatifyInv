[MESSAGES CONTROL]
# Disabled here, scoped to tests/, not the app code:
#
# missing-module-docstring / missing-function-docstring
#   Every test file already opens with a comment where it matters (see
#   test_list_products.py's sort-injection regression test), and every
#   test name is written to be the docstring ("test_adjust_stock_clamps_at_zero"
#   doesn't need a second sentence saying the same thing). Enforcing a
#   docstring on all ~80 test functions would mostly restate the function
#   name.
#
# redefined-outer-name
#   This is pylint not understanding pytest's fixture injection: a fixture
#   like `def client(app):` intentionally takes a same-named fixture as a
#   parameter -- that's how pytest wires fixtures together, not a real
#   shadowing bug.
disable=
    missing-module-docstring,
    missing-function-docstring,
    redefined-outer-name,
